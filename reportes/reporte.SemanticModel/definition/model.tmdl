model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["RutaParquet","Dim_Entidad","Fact_Demografia"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Entidad
ref table Fact_Demografia
ref table Dim_Calendario

ref cultureInfo es-MX

