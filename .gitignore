# =====================================================================
# GitIgnore - PIA Cómputo Científico 
# =====================================================================

# --- LaTeX Auxiliares (Archivos temporales de compilación) ---
*.aux
*.bbl
*.bcf
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.synctex.gz
*.toc
*.xdv
*.run.xml
*.synctex(busy)
._*.pdf
*.lof
*.lot
*.cb
*.cb2
*.upa
*.upb

*.pdf
!docs/*.pdf

# --- Python & Caché ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.ipynb_checkpoints/

# --- Entornos Virtuales e IDEs ---
.venv/
venv/
ENV/
env/
.vscode/
.idea/
*.swp
*.swo

# --- Archivos de Salida Propios de Simulaciones Pesadas ---
*.h5
*.nc
*.dat
*.npy
*.npz
output/
results/

# --- Power BI (.pbip cache temporal) ---
*.pbit
*.pbix.cache
**/.pbi/localSettings.json

# --- Sistema Operativo ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*