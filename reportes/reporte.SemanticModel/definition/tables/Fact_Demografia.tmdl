table Fact_Demografia
	lineageTag: 86bdc0bb-6e49-4e6b-93a3-2a8b87053a19

	measure 'Poblacion 2025' =
			
			-- Suma la población nacional censal del año base 2025 (Validación Pandas #1)
			CALCULATE(
			    SUM(Fact_Demografia[Poblacion_Total]),
			    Dim_Calendario[Anio] = 2025,
			    Fact_Demografia[Tipo_Dato] = "Histórico Censal"
			)
		lineageTag: ca00e07c-ec1c-428b-a194-bf131ab204a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Densidad Promedio 2025' =
			
			-- Promedio de densidad poblacional (hab/km²) de las 32 entidades en 2025 (Validación Pandas #2)
			CALCULATE(
			    AVERAGE(Fact_Demografia[Densidad_Pob]),
			    Dim_Calendario[Anio] = 2025,
			    Fact_Demografia[Tipo_Dato] = "Histórico Censal"
			)
		lineageTag: d3282e40-e2f0-411c-b0d4-e780ade71ee5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Poblacion Proyectada 2035' =
			
			-- Población proyectada a 2035 integrando la EDO logística con flujo migratorio mu (Validación Pandas #3)
			CALCULATE(
			    SUM(Fact_Demografia[Poblacion_Total]),
			    Dim_Calendario[Anio] = 2035,
			    Fact_Demografia[Tipo_Dato] = "Proyección (Con Migración)"
			)
		lineageTag: 5e762315-a12f-4151-94d2-fe1bcd388203

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brecha Migratoria 2035' = ```
			
			-- Habitantes netos ganados o perdidos en 2035 exclusivamente por migración interna (mu)
			VAR PobConMig = 
			    CALCULATE(
			        SUM(Fact_Demografia[Poblacion_Total]),
			        Dim_Calendario[Anio] = 2035,
			        Fact_Demografia[Tipo_Dato] = "Proyección (Con Migración)"
			    )
			VAR PobSinMig = 
			    CALCULATE(
			        SUM(Fact_Demografia[Poblacion_Total]),
			        Dim_Calendario[Anio] = 2035,
			        Fact_Demografia[Tipo_Dato] = "Proyección (Sin Migración)"
			    )
			RETURN
			    PobConMig - PobSinMig
			```
		lineageTag: 8f7df36d-e57e-4cf3-ac0a-3ce40fc98890

		annotation PBI_FormatHint = {"isGeneralNumber":true}

